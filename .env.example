# Supabase (opsional untuk dev — tanpa ini app memakai snapshot JSON lokal dari hasil import)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role key HANYA untuk skrip import (jangan diekspos ke browser)
SUPABASE_SERVICE_ROLE_KEY=

# Dataset export (read-only; URL dapat memakai NEXT_PUBLIC_SUPABASE_URL di atas)
SUPABASE_URL=
EXPORT_OUTPUT_DIR=output/anggaran_kita_apbd

# OPSIONAL — CARTO basemap default tidak butuh key.
# MapTiler vector style (alternatif basemap): isi key ATAU URL style lengkap.
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_MAP_STYLE_URL=
